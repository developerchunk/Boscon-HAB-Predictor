# Copy to .env and fill in. Vite exposes only VITE_-prefixed variables to the browser.
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Optional: lift the Open-Meteo free-tier quota (600/min, 5,000/hour, 10,000/day, weighted by request size).
# Either a paid customer-API key (customer-api.open-meteo.com, no hourly/daily cap)...
# VITE_OPEN_METEO_API_KEY=
# ...or a self-hosted Open-Meteo instance (unlimited; see README "Alternatives to the free API")
# VITE_OPEN_METEO_BASE=http://localhost:8080

# Optional: where the local NOMADS bridge listens (default http://localhost:8787). Start it with `npm run bridge`.
# VITE_NOMADS_BRIDGE=http://localhost:8787
